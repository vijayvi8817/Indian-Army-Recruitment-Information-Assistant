# Indian Army Recruitment Information Assistant - Environment Configuration

# Application Port Settings
PORT=8005
FRONTEND_PORT=5173

# Optional LLM API Key (Google Gemini API)
# If provided, Gemini synthesizes responses strictly using retrieved verified context.
# If omitted, system falls back to direct verified answer template matching.
GEMINI_API_KEY=

# Admin Authentication Secret Key
ADMIN_KEY=admin123

# Similarity Threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.35
